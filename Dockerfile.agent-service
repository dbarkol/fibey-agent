FROM python:3.12-slim

WORKDIR /app

# Copy uv for dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy project files
COPY pyproject.toml uv.lock ./
COPY src/ ./src/

# Install dependencies (includes agent, toolbox, Azure OpenAI, etc.)
RUN uv sync --no-dev

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "fibey.agent.service:app", "--host", "0.0.0.0", "--port", "8000"]
