# Microsoft Foundry
# For local dev, set these manually. For hosted agents, FOUNDRY_PROJECT_ENDPOINT
# is auto-injected by the Foundry platform.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=gpt-4.1-mini

# Agent Mode: "hosted" (proxy to Foundry hosted agent) or "local" (run in-process)
AGENT_MODE=local
HOSTED_AGENT_NAME=fibey-agent

# Foundry Toolbox MCP
# Set this to the toolbox MCP endpoint URL (including version).
# Example: https://<account>.services.ai.azure.com/api/projects/<project>/toolboxes/<name>/versions/<ver>/mcp?api-version=v1
TOOLBOX_MCP_URL=

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
